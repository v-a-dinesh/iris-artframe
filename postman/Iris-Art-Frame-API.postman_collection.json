    {
      "name": "Device Hardware (Pi / Frame)",
      "item": [
        {
          "name": "Update Dynamic IP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mac\": \"{{deviceMac}}\",\n  \"dynamic_ip\": \"{{dynamicIp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/device/dynamic-ip",
            "description": "Hardware reports dynamic IP on boot or when LAN IP changes. No auth required — device is identified by MAC address. Also marks device as online (updates last_seen_at)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Dynamic IP updated', () => {",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.dynamic_ip).to.eql(pm.collectionVariables.get('dynamicIp'));",
                  "});",
                  "if (json.device_id) pm.collectionVariables.set('deviceId', json.device_id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
