              "raw": "{\n  \"mac\": \"{{provisionMac}}\",\n  \"name\": \"{{provisionName}}\",\n  \"static_ip\": \"{{provisionStaticIp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/devices/provision"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.api_key) pm.collectionVariables.set('deviceApiKey', json.api_key);",
                  "    if (json.device) {",
                  "        pm.collectionVariables.set('deviceUuid', json.device.id);",
                  "        pm.collectionVariables.set('deviceId', json.device.device_id);",
                  "        if (json.device.mac) pm.collectionVariables.set('deviceMac', json.device.mac);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. User Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('userToken', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5. Register Device to User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{deviceId}}\",\n  \"name\": \"My Frame\"\n}"
            },
            "url": "{{baseUrl}}/api/devices/register"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('deviceUuid', pm.response.json().device.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6. Upload Image (pick file manually)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Choose JPG/PNG" }
              ]
            },
            "url": "{{baseUrl}}/api/images/upload"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const img = pm.response.json().image;",
                  "    pm.collectionVariables.set('imageUuid', img.id);",
                  "    pm.collectionVariables.set('imagePublicId', img.public_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "7. Queue Display",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_id\": \"{{imageUuid}}\"\n}"
            },
            "url": "{{baseUrl}}/api/devices/{{deviceUuid}}/display"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.json().job_id) {",
                  "    pm.collectionVariables.set('jobId', pm.response.json().job_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "8. Update Dynamic IP (Hardware)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mac\": \"{{deviceMac}}\",\n  \"dynamic_ip\": \"{{dynamicIp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/device/dynamic-ip"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dynamic IP updated', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
