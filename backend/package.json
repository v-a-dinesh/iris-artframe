{
  "name": "iris-artframe-backend",
  "version": "1.0.0",
  "description": "Iris Art Frame API - Node + Express + Turso",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
