          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List All Devices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/devices",
            "description": "List all provisioned devices (admin only)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.devices && json.devices.length > 0) {",
                  "    pm.collectionVariables.set('deviceUuid', json.devices[0].id);",
                  "    pm.collectionVariables.set('deviceId', json.devices[0].device_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Provision Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mac\": \"{{provisionMac}}\",\n  \"name\": \"{{provisionName}}\",\n  \"static_ip\": \"{{provisionStaticIp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/devices/provision",
            "description": "Provision a new frame from MAC address + static IP (both required). Returns QR payload (includes mac, static_ip, device_id), QR image, and api_key (shown once). Change `provisionMac` or `provisionStaticIp` if device/IP already exists."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.api_key) pm.collectionVariables.set('deviceApiKey', json.api_key);",
                  "    if (json.device) {",
                  "        pm.collectionVariables.set('deviceUuid', json.device.id);",
                  "        pm.collectionVariables.set('deviceId', json.device.device_id);",
                  "        if (json.device.mac) pm.collectionVariables.set('deviceMac', json.device.mac);",
                  "    }",
                  "    if (json.qr_payload) console.log('QR payload:', json.qr_payload);",
                  "    console.log('IMPORTANT: api_key saved to deviceApiKey — also copy from response!');",
                  "}",
                  "pm.test('Provision or conflict', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Regenerate QR",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/devices/{{deviceUuid}}/qr",
            "description": "Regenerate QR payload for a provisioned device (uses internal UUID `deviceUuid`). QR includes device_id, mac, and static_ip."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has QR data', () => pm.expect(json).to.have.property('qr_data_url'));",
                  "if (json.qr_payload) console.log('QR payload:', json.qr_payload);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Device (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"static_ip\": \"{{provisionStaticIp}}\",\n  \"dynamic_ip\": \"{{dynamicIp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/devices/{{deviceUuid}}",
            "description": "Admin: update static IP and/or dynamic IP for any provisioned device."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
